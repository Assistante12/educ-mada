{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Store authenticated student user accounts and academic preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "schoolName": { "type": "string" },
        "classId": { "type": "string" },
        "serieId": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email", "fullName", "classId"]
    },
    "StudentProgress": {
      "title": "Student Subject Progress",
      "description": "Progress and levels completed by a student for each subject",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subjectKey": { "type": "string" },
        "subjectId": { "type": "string" },
        "grade": { "type": "string" },
        "serieId": { "type": "string" },
        "currentLevel": { "type": "number" },
        "maxUnlockedLevel": { "type": "number" },
        "totalExercisesDone": { "type": "number" },
        "totalCorrect": { "type": "number" },
        "levelScores": { "type": "object" },
        "subjectTotalScore": { "type": "number" },
        "averageScore": { "type": "number" },
        "progressionPercent": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "subjectKey", "maxUnlockedLevel"]
    },
    "Lesson": {
      "title": "Curriculum Lesson Sheet",
      "description": "Comprehensive curriculum lesson and structured explanations cached from AI research",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classId": { "type": "string" },
        "serieId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "level": { "type": "number" },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "objectives": { "type": "array" },
        "coreTheory": { "type": "array" },
        "commonMistakes": { "type": "array" },
        "methodology": { "type": "array" },
        "solvedExample": { "type": "object" },
        "keyTakeaways": { "type": "array" },
        "officialReference": { "type": "string" },
        "source": { "type": "string" },
        "cachedAt": { "type": "string" }
      },
      "required": ["id", "classId", "subjectId", "level", "title", "theme", "coreTheory"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing identity, grade, school"
    },
    "/users/{userId}/progress/{subjectKey}": {
      "schema": "StudentProgress",
      "description": "Subcollection storing academic scores and level progression for each subject"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Collection storing cached curriculum lessons so AI research is only done once and shared with all students"
    }
  }
}
