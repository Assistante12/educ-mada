rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /progress/{subjectKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /lessons/{lessonId} {
      // Lessons are public educational resources that any student can read
      allow read: if true;
      // Lessons can be created or updated when generated to cache for subsequent students
      allow write: if true;
    }
  }
}
